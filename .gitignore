# macOS
.DS_Store
.AppleDouble
.LSOverride

# R / RStudio
.Rproj.user
.Rhistory
.RData
.RDataTmp
.Ruserdata
*.Rproj.user

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment and secrets
.env
.env.*


# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Logs
logs/
*.log

# Generated / scraped data — everything lives under data/ (rebuild with the
# python scrapers + R scripts 1-5). data/raw = scraped, data/processed = built.
data/
Archive/

# Large local artifacts
*.parquet

# Scratch / notes exports (source lives in analysis/*.R)
*.txt
# ...but the Python dependency manifest is tracked
!requirements.txt

# knitr build intermediates (the knitted .html report IS tracked; these are not:
# _cache/ holds large machine-specific model objects, _files/ holds figures the
# self-contained HTML already embeds)
*_cache/
*_files/

# Work in progress: drafts, article plans and study notes kept local until they
# are ready to publish (the knitted report in docs/ is the source of figures)
docs/In Progress/

# Office lock/temp files (Word writes these while a .docx or .pptx is open)
~$*
