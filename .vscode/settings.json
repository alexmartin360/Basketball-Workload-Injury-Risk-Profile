{
  "git.ignoreLimitWarning": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/nba_injuries/**": true,
    "**/nba_schedule/**": true,
    "**/nba_player_travel/**": true,
    "**/data_processed/**": true,
    "**/Archive/**": true
  }
}
