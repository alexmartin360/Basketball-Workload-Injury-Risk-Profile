# Core install helpers
if (!requireNamespace("remotes", quietly = TRUE)) install.packages("remotes")
# Try CRAN first
try(install.packages("nbainjuries"))
# If that fails, comment the line above and use the GitHub repo once you know it, e.g.
# remotes::install_github("USERNAME/nbainjuries")
# Useful supporting packages
pkgs <- c(
"dplyr", "tidyr", "ggplot2", "janitor", "skimr",
"lubridate", "purrr", "stringr", "survival",
"survminer", "slider"
)
to_install <- pkgs[!pkgs %in% rownames(installed.packages())]
if (length(to_install) > 0) install.packages(to_install)
# Load packages
library(nbainjuries)
install.packages('nbainjuries')
